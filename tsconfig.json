{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@ddv/core": ["./packages/core/src/index.ts"],
      "@ddv/core/node": ["./packages/core/src/node-index.ts"],
      "@ddv/graph": ["./packages/graph/src/index.ts"],
      "@ddv/github": ["./packages/github/src/index.ts"],
      "@ddv/testid/core": ["./packages/testid/src/core.ts"],
      "@ddv/testid": ["./packages/testid/src/index.ts"],
      "@ddv/services": ["./packages/services/src/index.ts"],
      "@ddv/mock/step": ["./packages/mock/src/step.ts"],
      "@ddv/mock/platform": ["./packages/mock/src/platform.ts"],
      "@ddv/mock/browser": ["./packages/mock/src/browser-safe.ts"],
      "@ddv/mock/frame-protocol": ["./packages/mock/src/frame-protocol.ts"],
      "@ddv/mock/playwright": ["./packages/mock/src/playwright.ts"],
      "@ddv/mock/tune": ["./packages/mock/src/tune.ts"],
      "@ddv/mock/tune-patch": ["./packages/mock/src/tune-patch.ts"],
      "@ddv/mock/yaml-patch": ["./packages/mock/src/yaml-patch.ts"],
      "@ddv/mock/trace-format": ["./packages/mock/src/trace-format.ts"],
      "@ddv/mock/trace": ["./packages/mock/src/trace.ts"],
      "@ddv/mock-runtime": ["./packages/mock-runtime/src/index.ts"],
      "@ddv/desktop/check": ["./packages/desktop/src/check.ts"],
      "@ddv/desktop/cli": ["./packages/desktop/src/cli.ts"],
      "@ddv/desktop/gate": ["./packages/desktop/src/gate.ts"],
      "@ddv/desktop/run": ["./packages/desktop/src/run.ts"],
      "@ddv/desktop": ["./packages/desktop/src/index.ts"],
      "@ddv/tokens/node": ["./packages/tokens/src/node.ts"],
      "@ddv/tokens": ["./packages/tokens/src/index.ts"],
      "@ddv/mock": ["./packages/mock/src/index.ts"],
      "@ddv/evidence/spec": ["./packages/evidence/src/spec.ts"],
      "@ddv/evidence/with": ["./packages/evidence/src/with.ts"],
      "@ddv/evidence/config": ["./packages/evidence/src/config.ts"],
      "@ddv/evidence/sql-guard": ["./packages/evidence/src/sql-guard.ts"],
      "@ddv/evidence/registry": ["./packages/evidence/src/registry.ts"],
      "@ddv/evidence/hooks-scan": ["./packages/evidence/src/hooks-scan.ts"],
      "@ddv/evidence/check": ["./packages/evidence/src/check.ts"],
      "@ddv/evidence/cli": ["./packages/evidence/src/cli.ts"],
      "@ddv/evidence/store": ["./packages/evidence/src/store.ts"],
      "@ddv/evidence/redact": ["./packages/evidence/src/redact.ts"],
      "@ddv/evidence/runner": ["./packages/evidence/src/runner.ts"],
      "@ddv/evidence/run": ["./packages/evidence/src/run.ts"],
      "@ddv/evidence/counts": ["./packages/evidence/src/counts.ts"],
      "@ddv/evidence/branch-limit": ["./packages/evidence/src/branch-limit.ts"],
      "@ddv/evidence": ["./packages/evidence/src/index.ts"],
      "#backend-impl": ["./apps/web/src/backend/http.ts"],
      "#app-impl": ["./apps/web/src/App.tsx"]
    }
  },
  "include": ["./packages/*/src", "apps/*/src", "apps/web/scripts", "e2e", "e2e-pages", "vitest.config.ts", "playwright.config.ts", "playwright.pages.config.ts"]
}

