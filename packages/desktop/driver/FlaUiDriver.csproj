<Project Sdk="Microsoft.NET.Sdk">

  <!-- ddv の FlaUI のドライバ（docs/design/detailed/flaui-driver.md）。標準入出力で 1 行 1 つの JSON をやりとりする -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FlaUiDriver</AssemblyName>
    <RootNamespace>Ddv.FlaUiDriver</RootNamespace>
    <Version>0.1.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA2" Version="4.0.0" />
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />
  </ItemGroup>

</Project>
