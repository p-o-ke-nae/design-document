<UserControl x:Class="OrderApp.Wpf.Views.ListScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="List">
  <!-- 画面 List（注文一覧） -->
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="注文一覧" Style="{StaticResource Heading}" />
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
      <!-- new は C# のキーワードなので x:Name ではなく AutomationId で名前を付ける -->
      <Button AutomationProperties.AutomationId="new" Content="新規" Command="{Binding NewCommand}" />
    </StackPanel>
    <DataGrid x:Name="orders" ItemsSource="{Binding Orders}" AutoGenerateColumns="False"
              IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
      <DataGrid.Columns>
        <DataGridTextColumn Header="番号" Binding="{Binding Id}" />
        <DataGridTextColumn Header="顧客名" Binding="{Binding Customer}" Width="*" />
        <DataGridTextColumn Header="商品" Binding="{Binding Sku}" />
        <DataGridTextColumn Header="数量" Binding="{Binding Quantity}" />
        <DataGridTextColumn Header="状態" Binding="{Binding Status}" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
