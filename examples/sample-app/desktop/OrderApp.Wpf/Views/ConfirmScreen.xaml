<UserControl x:Class="OrderApp.Wpf.Views.ConfirmScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Confirm">
  <!-- 画面 Confirm（入力確認）。名前に - を含むものは AutomationId で付ける -->
  <StackPanel>
    <TextBlock Text="入力確認" Style="{StaticResource Heading}" />
    <Grid Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="96" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Text="顧客名" Foreground="#475569" Margin="0,3" />
      <TextBlock Grid.Row="0" Grid.Column="1" AutomationProperties.AutomationId="confirm-customer" Text="{Binding ConfirmCustomer}" Margin="0,3" />
      <TextBlock Grid.Row="1" Text="商品" Foreground="#475569" Margin="0,3" />
      <TextBlock Grid.Row="1" Grid.Column="1" AutomationProperties.AutomationId="confirm-sku" Text="{Binding ConfirmSku}" Margin="0,3" />
      <TextBlock Grid.Row="2" Text="数量" Foreground="#475569" Margin="0,3" />
      <TextBlock Grid.Row="2" Grid.Column="1" AutomationProperties.AutomationId="confirm-quantity" Text="{Binding ConfirmQuantity}" Margin="0,3" />
    </Grid>
    <!-- 在庫不足のときは画面に留まり、メッセージを表示する -->
    <TextBlock AutomationProperties.AutomationId="submit-error" Style="{StaticResource ErrorText}"
               Text="{Binding SubmitError}"
               Visibility="{Binding HasSubmitError, Converter={StaticResource BoolToVisibility}}" />
    <StackPanel Orientation="Horizontal">
      <Button x:Name="back" Content="戻る" Command="{Binding BackCommand}" />
      <Button x:Name="submit" Content="確定" Command="{Binding SubmitCommand}" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</UserControl>
