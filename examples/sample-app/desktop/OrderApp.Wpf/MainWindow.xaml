<Window x:Class="OrderApp.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:OrderApp.Wpf.Views"
        Title="注文受付" Width="640" Height="480"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#1E3A8A" Padding="16,10">
      <TextBlock Text="注文受付" Foreground="White" FontSize="16" FontWeight="SemiBold" />
    </Border>
    <!-- 表示中の画面は 1 つだけ（画面遷移図の状態ID = UserControl の x:Name） -->
    <ContentControl Content="{Binding}" Margin="16" Focusable="False">
      <ContentControl.Style>
        <Style TargetType="ContentControl">
          <Style.Triggers>
            <DataTrigger Binding="{Binding Screen}" Value="List">
              <Setter Property="ContentTemplate">
                <Setter.Value><DataTemplate><views:ListScreen /></DataTemplate></Setter.Value>
              </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding Screen}" Value="Input">
              <Setter Property="ContentTemplate">
                <Setter.Value><DataTemplate><views:InputScreen /></DataTemplate></Setter.Value>
              </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding Screen}" Value="Confirm">
              <Setter Property="ContentTemplate">
                <Setter.Value><DataTemplate><views:ConfirmScreen /></DataTemplate></Setter.Value>
              </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding Screen}" Value="Done">
              <Setter Property="ContentTemplate">
                <Setter.Value><DataTemplate><views:DoneScreen /></DataTemplate></Setter.Value>
              </Setter>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ContentControl.Style>
    </ContentControl>
  </DockPanel>
</Window>
